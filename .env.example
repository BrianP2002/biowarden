# Copy to .env (git-ignored) and fill in the keys you use. Never commit real keys.
# Prefixed names on purpose: Claude Code uses an exported ANTHROPIC_API_KEY instead of the
# subscription login, so the bare name must not be set in .env or the shell.
BIOWARDEN_ANTHROPIC_API_KEY=
# BIOWARDEN_DEEPSEEK_API_KEY=
# BIOWARDEN_ZAI_API_KEY=
# BIOWARDEN_OPENROUTER_API_KEY=
