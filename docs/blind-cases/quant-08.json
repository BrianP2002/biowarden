 "setup": [
  "head -n 6 transcripts.fa > transcripts_prev.fa",
  "kallisto index -i transcripts.idx transcripts_prev.fa >/dev/null 2>&1",
  "rm -f transcripts_prev.fa",
  "touch -d '3 days ago' transcripts.idx"
 ],
 "faulted": "test -f transcripts.idx || kallisto index -i transcripts.idx transcripts.fa; kallisto quant -i transcripts.idx -o kallisto_out sample_R1.fastq sample_R2.fastq",
 "clean": "kallisto index -i transcripts.idx transcripts.fa && kallisto quant -i transcripts.idx -o kallisto_out sample_R1.fastq sample_R2.fastq",
 "observe": "cut -f1,4 kallisto_out/abundance.tsv | awk 'NR==1{print; next}{printf \"%s\\t%.0f\\n\", $1, $2}'"
}
