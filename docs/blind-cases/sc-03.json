  "make_pooled.py": "import anndata as ad\nimport pandas as pd\nimport scanpy as sc\n\nadata = sc.read_csv(\"pooled_counts.csv\")\nmeta = pd.read_csv(\"pooled_meta.csv\", index_col=0)\nadata.obs = meta.loc[adata.obs_names].copy()\nadata.obs[\"batch\"] = pd.Categorical(adata.obs[\"batch\"])\nsc.pp.normalize_total(adata, target_sum=1e4)\nsc.pp.log1p(adata)\nsc.pp.pca(adata, n_comps=10, random_state=0)\nadata.write_h5ad(\"pooled_donors.h5ad\")\n",
  "combat_graph.py": "import anndata as ad\nimport numpy as np\nimport scanpy as sc\n\nadata = ad.read_h5ad(\"pooled_donors.h5ad\")\nsc.pp.combat(adata, key=\"batch\")\nsc.pp.neighbors(adata, n_neighbors=6, method=\"gauss\", random_state=0)\n\ndist = adata.obsp[\"distances\"].tocsr()\nbatch = adata.obs[\"batch\"].astype(str).values\nother = [np.mean(batch[dist[i].indices] != batch[i]) for i in range(adata.n_obs)]\nopen(\"batch_mixing.txt\", \"w\").write(f\"cross_batch_neighbour_fraction {np.mean(other):.2f}\\n\")\n",
  "combat_graph_v2.py": "import anndata as ad\nimport numpy as np\nimport scanpy as sc\n\nadata = ad.read_h5ad(\"pooled_donors.h5ad\")\nsc.pp.combat(adata, key=\"batch\")\nsc.pp.pca(adata, n_comps=10, random_state=0)\nsc.pp.neighbors(adata, n_neighbors=6, method=\"gauss\", random_state=0)\n\ndist = adata.obsp[\"distances\"].tocsr()\nbatch = adata.obs[\"batch\"].astype(str).values\nother = [np.mean(batch[dist[i].indices] != batch[i]) for i in range(adata.n_obs)]\nopen(\"batch_mixing.txt\", \"w\").write(f\"cross_batch_neighbour_fraction {np.mean(other):.2f}\\n\")\n"
